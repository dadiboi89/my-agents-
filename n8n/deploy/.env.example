# Copy this file to ".env" in this same folder, then fill in the value below.
# docker compose reads .env automatically — do not commit your real .env.

# Just the hostname of your tunnel, no "https://" and no trailing slash.
# Cloudflare Quick Tunnel example: random-words-1234.trycloudflare.com
# ngrok example: yourname.ngrok-free.app
PUBLIC_HOST=

# Optional — only needed for WF3's keyframe batch (Kling developer console API keys,
# separate from Kling app credits):
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
