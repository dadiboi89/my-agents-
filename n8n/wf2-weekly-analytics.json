{
  "name": "Limoncino WF2 — Weekly Analytics",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Every Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "sheet_id",
              "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "telegram_chat_id",
              "value": "REPLACE_WITH_TELEGRAM_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [200, 0]
    },
    {
      "parameters": {
        "url": "https://youtubeanalytics.googleapis.com/v2/reports",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "youTubeOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ids",
              "value": "channel==MINE"
            },
            {
              "name": "startDate",
              "value": "={{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "endDate",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "metrics",
              "value": "views,estimatedMinutesWatched,averageViewDuration,subscribersGained"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "YouTube Analytics API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "m1",
              "name": "week_of",
              "value": "={{ $now.minus({ days: 7 }).toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "m2",
              "name": "views",
              "value": "={{ $json.rows && $json.rows[0] ? $json.rows[0][0] : 0 }}",
              "type": "number"
            },
            {
              "id": "m3",
              "name": "watch_minutes",
              "value": "={{ $json.rows && $json.rows[0] ? $json.rows[0][1] : 0 }}",
              "type": "number"
            },
            {
              "id": "m4",
              "name": "avg_view_seconds",
              "value": "={{ $json.rows && $json.rows[0] ? $json.rows[0][2] : 0 }}",
              "type": "number"
            },
            {
              "id": "m5",
              "name": "subs_gained",
              "value": "={{ $json.rows && $json.rows[0] ? $json.rows[0][3] : 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Shape Metrics",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 0]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').item.json.sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Analytics Log"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Sheets: Append Analytics",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [800, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $('Config').item.json.telegram_chat_id }}",
        "text": "=📊 Limoncino TV — settimana {{ $('Shape Metrics').item.json.week_of }}:\n👀 {{ $('Shape Metrics').item.json.views }} visualizzazioni\n⏱ {{ $('Shape Metrics').item.json.watch_minutes }} minuti guardati\n📈 {{ $('Shape Metrics').item.json.subs_gained }} nuovi iscritti",
        "additionalFields": {}
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Telegram: Weekly Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1000, 0]
    }
  ],
  "connections": {
    "Every Monday 08:00": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "YouTube Analytics API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Analytics API": {
      "main": [
        [
          {
            "node": "Shape Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Metrics": {
      "main": [
        [
          {
            "node": "Sheets: Append Analytics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sheets: Append Analytics": {
      "main": [
        [
          {
            "node": "Telegram: Weekly Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
