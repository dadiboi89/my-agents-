      "name": "Loop Shots",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [600, 0]
    },
    {
      "parameters": {
        "jsCode": "// Builds the JWT Kling's API requires (HS256, 30 min validity).\n// Requires env vars KLING_ACCESS_KEY / KLING_SECRET_KEY on the n8n host\n// and NODE_FUNCTION_ALLOW_BUILTIN=crypto so require('crypto') works.\nconst crypto = require('crypto');\nconst ak = $env.KLING_ACCESS_KEY;\nconst sk = $env.KLING_SECRET_KEY;\nif (!ak || !sk) { throw new Error('Set KLING_ACCESS_KEY and KLING_SECRET_KEY env vars'); }\nconst now = Math.floor(Date.now() / 1000);\nconst b64 = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');\nconst header = b64({ alg: 'HS256', typ: 'JWT' });\nconst payload = b64({ iss: ak, exp: now + 1800, nbf: now - 5 });\nconst sig = crypto.createHmac('sha256', sk).update(header + '.' + payload).digest('base64url');\nreturn $input.all().map(item => ({ json: { ...item.json, kling_jwt: header + '.' + payload + '.' + sig } }));"
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Build Kling JWT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-singapore.klingai.com/v1/images/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.kling_jwt }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model_name: 'kling-v2', prompt: $json.Prompt, aspect_ratio: '16:9', n: 1 }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "Kling: Create Image Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 100]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "c3000000-0000-4000-8000-000000000007",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 100]
    },
    {
      "parameters": {
        "url": "=https://api-singapore.klingai.com/v1/images/generations/{{ $('Kling: Create Image Task').item.json.data.task_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Build Kling JWT').item.json.kling_jwt }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000008",
      "name": "Kling: Check Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 100]
    },
    {
      "parameters": {
        "conditions": {
