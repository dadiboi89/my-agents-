            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.data.task_status }}",
              "rightValue": "succeed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000009",
      "name": "Task Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1600, 100]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Shots"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Shot": "={{ $('Loop Shots').item.json.Shot }}",
            "Keyframe": "={{ $json.data.task_result.images[0].url }}"
          },
          "matchingColumns": ["Shot"]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000010",
      "name": "Sheets: Write Keyframe URL",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
