{
  "mcpServers": {
    "creatomate": {
      "command": "node",
      "args": ["./creatomate-mcp/index.js"],
      "env": {
        "CREATOMATE_API_KEY": "${CREATOMATE_API_KEY}",
        "NODE_USE_ENV_PROXY": "1"
      }
    },
    "n8n": {
      "command": "node",
      "args": ["./n8n-mcp/index.js"],
      "env": {
        "N8N_BASE_URL": "${N8N_BASE_URL}",
        "N8N_API_KEY": "${N8N_API_KEY}",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
